# Copy to .env.local (gitignored) and fill in. Missing required vars warn, not fail.

# Airtable — email signups + ticket purchases. [required]
# Token: https://airtable.com/create/tokens
#   Scopes: data.records:write and data.records:read.
#   Add schema.bases:read too, so /grade picks up new select options and edited
#   field descriptions from Airtable without a deploy (falls back quietly without it).
AIRTABLE_API_KEY=

# PostHog web analytics. Set the public project key in deployment settings.
# The payment webhooks also use it to send ticket_purchased events.
# Leave blank to disable tracking locally; never commit personal API keys.
NEXT_PUBLIC_POSTHOG_KEY=

# Stripe — ticket purchase webhook. [optional]
# STRIPE_WEBHOOK_SECRET (local): stripe listen --forward-to localhost:3000/api/stripe-webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Promo code for in-prod test purchases; flags matching purchases as Test in Airtable.
STRIPE_TEST_99_CODE=

# Promo-code tool at /admin/promo. [optional]
# STRIPE_PROMO_KEY: a RESTRICTED key (Promotion codes: Write, Coupons: Read) — never
#   the full secret key; rk_test_ locally. Coupons themselves are made in the dashboard.
# COMP_COUPON_ID: id of the hand-made 100%-off coupon (default pick in the dropdown).
STRIPE_PROMO_KEY=
COMP_COUPON_ID=
# FAMILY_REFERRAL_COUPON_ID: id of the hand-made $50-off coupon a referred friend gets on a
#   Standard ticket (the Family & Friends price). Unset: referrals record but don't discount.
FAMILY_REFERRAL_COUPON_ID=

# Resend — ticket-confirmation + admin-alert emails from the Stripe webhook. [optional]
# API key from the resend.com dashboard; email sends no-op without it.
RESEND_API_KEY=

# Contact form — one CONTACT_EMAIL_<KEY> per team member with a `contactKey` in
# src/v2/data/team.ts (e.g. contactKey "ricki" → CONTACT_EMAIL_RICKI). [optional]
# The repo is public, so addresses never go in source. A member whose var is
# unset gets no contact link on /team (checked at build, so keep these
# non-sensitive on Vercel or the CI build can't see them).
CONTACT_EMAIL_RICKI=

# OpenNode — Bitcoin ticket checkout. [optional]
# OPENNODE_KEY: API key from the OpenNode dashboard (Developers → API Keys).
#   Use a dev/sandbox key with OPENNODE_ENV=dev; a live key with OPENNODE_ENV=live.
# OPENNODE_ENV: "dev" (sandbox, dev-api.opennode.com) or "live" (api.opennode.com).
OPENNODE_KEY=
OPENNODE_ENV=dev

# Copy /grade's writes to the Airtable RFP rows outside production. [optional]
# RFP_AIRTABLE_MIRROR=1

# Public site origin (e.g. https://2026.metagame.games) used to build OpenNode
# success/callback URLs. Falls back to the request origin when unset. [optional]
# NEXT_PUBLIC_SITE_URL=

# Neon Postgres (accounts, tickets, schedule). [optional until the DB ships]
# On Vercel the Neon Marketplace integration sets this per environment. Locally,
# point it at your own Neon branch (Neon console → Branches → create from main).
# Schema lives in src/db/schema; after changing it run `pnpm db:generate` and
# commit the SQL it writes to drizzle/. `pnpm db:migrate` applies it.
# DATABASE_URL=

# Better Auth (accounts at /login and /account). [optional until accounts ship]
# Any long random string, e.g. `openssl rand -hex 32`. Rotating it signs
# everyone out. Sign-in codes go out through RESEND_API_KEY above.
# BETTER_AUTH_SECRET=

# Budget tool at /backstage/budget: Xero → Claude → the budget Google Sheet. [optional]
# XERO_CLIENT_ID / XERO_CLIENT_SECRET: the Xero app (developer.xero.com); add
#   NEXT_PUBLIC_SITE_URL + /api/budget/xero/callback (prod: https://metagame.games)
#   to its redirect URIs. All of these are runtime-only, so store them as
#   Sensitive on Vercel. The rotating tokens
#   live in Postgres (xero_connections), written by the one-time Connect flow.
# ANTHROPIC_API_KEY: categorizes new Xero lines into proposals.
# GOOGLE_SERVICE_ACCOUNT_JSON: a service-account key JSON (raw or base64); share
#   the budget sheet with the account's client_email as an editor.
# BUDGET_SHEET_ID: defaults to the Metagame 2026 Budget sheet.
# BUDGET_MODEL: defaults to claude-opus-5-5.
# CRON_SECRET: any random string; Vercel sends it to the weekly token keepalive.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
ANTHROPIC_API_KEY=
GOOGLE_SERVICE_ACCOUNT_JSON=
# BUDGET_SHEET_ID=
# BUDGET_MODEL=
CRON_SECRET=
