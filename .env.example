# ─────────────────────────────────────────────────────────────────────────────
# Metagame 2026 — environment variables
#
# Copy this file to `.env.local` and fill in the values:
#     cp .env.example .env.local
#
# `.env.local` is gitignored — never commit real secrets. Missing *required*
# vars print a warning on `next dev` / `next build` (see src/env.ts). The site
# still runs without them; email signups just won't be stored.
# ─────────────────────────────────────────────────────────────────────────────

# --- Airtable (email signups) ------------------------------------------------- [required]
# Destination: the "Interest Intake" table in the "Metagame 2026" base. The base/table
# ids below aren't secret (useless without the token), so they're prefilled — you only
# need to add the token.
# Token: https://airtable.com/create/tokens — scope `data.records:write`, granted access
# to the Metagame 2026 base only. Paste it into .env.local (NOT here).
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=appROpPV6XUP4CSqX
AIRTABLE_TABLE_ID=tbluUIxg0YnlMO1jQ
# Email column name in that table. Optional — defaults to "Email".
AIRTABLE_EMAIL_FIELD=Email

# --- Supabase (not used yet) -------------------------------------------------- [optional]
# Placeholders only — nothing reads these today. Uncomment + fill if/when we
# add Supabase, and register them in src/env.ts so the check covers them.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
