# Copy to .env.local (gitignored) and fill in. Missing required vars warn, not fail.

# Airtable — email signups + ticket purchases. [required]
# Token: https://airtable.com/create/tokens (scope: data.records:write)
AIRTABLE_API_KEY=

# Stripe — ticket purchase webhook. [optional]
# STRIPE_WEBHOOK_SECRET (local): stripe listen --forward-to localhost:3000/api/stripe-webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Promo code for in-prod test purchases; flags matching purchases as Test in Airtable.
STRIPE_TEST_99_CODE=

# Resend — ticket-confirmation + admin-alert emails from the Stripe webhook. [optional]
# API key from the resend.com dashboard; email sends no-op without it.
RESEND_API_KEY=

# OpenNode — Bitcoin ticket checkout. [optional]
# OPENNODE_KEY: API key from the OpenNode dashboard (Developers → API Keys).
#   Use a dev/sandbox key with OPENNODE_ENV=dev; a live key with OPENNODE_ENV=live.
# OPENNODE_ENV: "dev" (sandbox, dev-api.opennode.com) or "live" (api.opennode.com).
OPENNODE_KEY=
OPENNODE_ENV=dev

# Public site origin (e.g. https://2026.metagame.games) used to build OpenNode
# success/callback URLs. Falls back to the request origin when unset. [optional]
# NEXT_PUBLIC_SITE_URL=

# Supabase — not used yet. [optional]
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
